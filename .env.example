# APP_URL=http://localhost:8082
# SMS_PROVIDER=hubtel
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_SENDER=CryoChain
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER=CryoChain
