EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Publishable key (sb_publishable_...). Used when the anon key above is empty.
# EXPO_PUBLIC_SUPABASE_KEY=

# Edge Function secrets, set in the Supabase dashboard. Never put these in the app.
# SUPABASE_SERVICE_ROLE_KEY is injected for hosted functions.
# PAYSTACK_SECRET_KEY=sk_test_xxx
# APP_URL is the page Paystack sends the buyer back to after checkout.
# APP_URL=http://localhost:8082
# SMS_PROVIDER=hubtel
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_SENDER=CryoChain
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER=CryoChain

# Google Maps. The web key (HTTP-referrer restricted) and the native key (package/bundle restricted) are public.
# EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=…
# GOOGLE_MAPS_ANDROID_KEY=…
# GOOGLE_MAPS_IOS_KEY=…
# Edge Function secret (Places + Geocoding): supabase secrets set GOOGLE_MAPS_SERVER_KEY=…
# GOOGLE_MAPS_SERVER_KEY=…
