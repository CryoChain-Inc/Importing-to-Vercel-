{
  "expo": {
    "name": "CryoChain",
    "slug": "cryochain-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6F4",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6F4"
    },
    "ios": {
      "bundleIdentifier": "com.cryochain.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cryochain.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F4F6F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "CryoChain uses the camera to photograph crates, the scale, and the cold-box gauge.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CryoChain uses your location to pin your farm or delivery address on the map, and to share the truck position with operations during a collection run."
        }
      ]
    ],
    "scheme": "cryochain",
    "extra": {
      "eas": {
        "projectId": "7d7afd4a-cdc9-4b29-8192-817993ad7b63"
      }
    }
  }
}
